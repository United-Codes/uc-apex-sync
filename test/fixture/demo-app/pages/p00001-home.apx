page 1 (
    name: Home
    alias: HOME
    title: Home
    appearance {
        pageTemplate: @/standard
    }

    region intro (
        name: Intro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        source {
            htmlCode: Welcome to Home
        }
    )

    region report (
        name: Report
        type: classicReport
        layout {
            sequence: 20
            slot: body
        }
        source {
            sqlQuery: select * from home
        }
    )

    region footer (
        name: Footer
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        source {
            htmlCode: Home footer
        }
    )
)
